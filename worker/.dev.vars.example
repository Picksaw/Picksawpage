# Local development secrets for `wrangler dev` ONLY.
#
# 1. Copy this file to `.dev.vars` (which is git-ignored).
# 2. Fill in real values there.
# 3. NEVER commit `.dev.vars`.
#
# In production these are set as Cloudflare Secrets, NOT from this file.

ADMIN_PASSWORD="change-me-locally"
AUTH_SIGNING_KEY="generate-a-long-random-string"
